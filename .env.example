# ===================================================
# MyFinance Database & Environment Configuration
# ===================================================
# For local XAMPP development, defaults are used automatically:
# DB_HOST=localhost, DB_USER=root, DB_PASSWORD='', DB_NAME=myfinance, DB_PORT=3306

# For Vercel Production Deployment:
# Add the following keys in Vercel Dashboard -> Settings -> Environment Variables

DB_HOST=your-cloud-mysql-host.com
DB_PORT=3306
DB_NAME=myfinance
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_SSL=false

# Optional Security Key for HMAC cookie signing
APP_SECRET=your_random_64_character_secret_key
